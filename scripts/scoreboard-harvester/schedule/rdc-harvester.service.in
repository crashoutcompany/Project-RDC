# systemd user service for the weekly scoreboard harvest.
# Don't copy this file directly: schedule/install.sh fills in @REPO@.
[Unit]
Description=RDC scoreboard harvester
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart="@REPO@/scripts/scoreboard-harvester/schedule/run-weekly.sh"
# Stay out of the way of anything interactive on the box.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=8h
