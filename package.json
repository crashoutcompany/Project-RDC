{
  "name": "projectrdc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate --sql",
    "build": "next build",
    "build-memory": "next build --experimental-debug-memory-usage",
    "build-prerender": "next build --debug-prerender",
    "start": "next start",
    "lint": "eslint .",
    "dbcrashout": "npx prisma db push --force-reset && npx prisma db push && npx tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "playwright:install": "playwright install chromium",
    "test:instant": "INSTANT_NAV_TEST_BUILD=1 npm run build && INSTANT_NAV_TEST_BUILD=1 playwright test",
    "test:instant:ui": "INSTANT_NAV_TEST_BUILD=1 npm run build && INSTANT_NAV_TEST_BUILD=1 playwright test --ui",
    "prepare": "test -z \"$CI\" && husky || true",
    "update-neon-branch": "tsx scripts/update-neon-branch.ts",
    "harvest": "tsx scripts/scoreboard-harvester/index.ts",
    "harvest:build-ocr": "bash scripts/scoreboard-harvester/ocr-tool/build.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
