{
  "name": "projectrdc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate --sql",
    "build": "next build",
    "build-memory": "next build --experimental-debug-memory-usage",
    "build-prerender": "next build --debug-prerender",
    "start": "next start",
    "lint": "eslint .",
    "doctor": "react-doctor",
    "dbcrashout": "npx prisma db push --force-reset && npx prisma db push && npx tsx prisma/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install chromium",
    "build:e2e": "EXPOSE_TESTING_API=1 next build",
    "test:e2e": "pnpm build:e2e && EXPOSE_TESTING_API=1 playwright test",
    "test:e2e:ui": "pnpm build:e2e && EXPOSE_TESTING_API=1 playwright test --ui",
    "test:instant": "pnpm test:e2e",
    "test:instant:ui": "pnpm test:e2e:ui",
    "prepare": "test -z \"$CI\" && husky || true",
    "update-neon-branch": "tsx scripts/update-neon-branch.ts",
    "harvest": "tsx scripts/scoreboard-harvester/index.ts",
    "harvest:build-ocr": "bash scripts/scoreboard-harvester/ocr-tool/build.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.56",
    "@ai-sdk/otel": "^1.0.85",
    "@azure-rest/ai-document-intelligence": "^1.0.0-beta.3",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@posthog/ai": "^8.17.2",
    "@prisma/adapter-neon": "^7.1.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.83",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "^1.7.17",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.0",
    "googleapis": "^159.0.0",
    "lucide-react": "^0.560.0",
    "motion": "^14.0.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.425.0",
    "posthog-node": "^5.51.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.57.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.3.0",
    "resend": "^6.5.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "uuid": "^14.0.3",
    "ws": "^8.18.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@next/playwright": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.29",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "neonctl": "^8.0.1",
    "openai": "^7.32.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "prisma": "^7.8.0",
    "prisma-json-types-generator": "^5.1.1",
    "react-doctor": "^0.9.17",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@modelcontextprotocol/sdk": "^1.32.2",
      "deepmerge-ts": "^8.0.2",
      "dompurify": "^3.4.17",
      "undici": "^7.30.1"
    }
  }
}
